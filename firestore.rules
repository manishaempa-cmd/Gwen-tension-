rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.preferredLanguage in ['en-IN', 'hi-IN', 'hinglish'] &&
             data.preferredModel in ['gemini-3.8-flash', 'gemini-3.5-flash-lite', 'gemini-4-argon'] &&
             data.memoryEnabled is bool &&
             data.voiceEnrolled is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMemoryItem(data) {
      return data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 4000 &&
             data.category in ['preference', 'context', 'note', 'gaming'] &&
             data.isApproved is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidConversation(data) {
      return data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.mode in ['general', 'coding', 'research', 'story', 'translation', 'gaming'] &&
             data.lastMessagePreview is string && data.lastMessagePreview.size() <= 300 &&
             data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 10000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidChatMessage(data) {
      return data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.role in ['user', 'assistant'] &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 20000 &&
             data.expression is string && data.expression.size() >= 1 && data.expression.size() <= 32 &&
             data.hasImage is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidAssistantTask(data) {
      return data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.command is string && data.command.size() >= 1 && data.command.size() <= 500 &&
             data.category in ['phone', 'ai', 'media', 'screen', 'memory'] &&
             data.stage in ['understanding', 'analyzing', 'planning', 'checking_permissions', 'executing', 'verifying', 'completed', 'failed'] &&
             data.planSummary is string && data.planSummary.size() <= 2000 &&
             data.verificationResult is string && data.verificationResult.size() <= 1000 &&
             data.requiresInternet is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'preferredLanguage', 'preferredModel', 'memoryEnabled', 'voiceEnrolled', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'preferredLanguage', 'preferredModel', 'memoryEnabled', 'voiceEnrolled', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredLanguage', 'preferredModel', 'memoryEnabled', 'voiceEnrolled', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /memories/{memoryId} {
        allow get: if isOwner(userId) && isValidId(memoryId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(memoryId) &&
                         incoming().keys().hasAll(['userId', 'title', 'content', 'category', 'isApproved', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'content', 'category', 'isApproved', 'createdAt', 'updatedAt']) &&
                         isValidMemoryItem(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(memoryId) &&
                         isValidMemoryItem(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'category', 'isApproved', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(memoryId);
      }

      match /conversations/{conversationId} {
        allow get: if isOwner(userId) && isValidId(conversationId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(conversationId) &&
                         incoming().keys().hasAll(['userId', 'title', 'mode', 'lastMessagePreview', 'messageCount', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'mode', 'lastMessagePreview', 'messageCount', 'createdAt', 'updatedAt']) &&
                         isValidConversation(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(conversationId) &&
                         isValidConversation(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'mode', 'lastMessagePreview', 'messageCount', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(conversationId);

        match /messages/{messageId} {
          allow get: if isOwner(userId) && isValidId(conversationId) && isValidId(messageId);
          allow list: if isOwner(userId) && isValidId(conversationId);

          allow create: if isOwner(userId) &&
                           isValidId(conversationId) &&
                           isValidId(messageId) &&
                           incoming().keys().hasAll(['userId', 'role', 'text', 'expression', 'hasImage', 'createdAt']) &&
                           incoming().keys().hasOnly(['userId', 'role', 'text', 'expression', 'hasImage', 'createdAt']) &&
                           isValidChatMessage(incoming()) &&
                           existsAfter(/databases/$(database)/documents/users/$(userId)/conversations/$(conversationId));

          allow update: if false;
          allow delete: if isOwner(userId) && isValidId(conversationId) && isValidId(messageId);
        }
      }

      match /tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(taskId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(taskId) &&
                         incoming().keys().hasAll(['userId', 'command', 'category', 'stage', 'planSummary', 'verificationResult', 'requiresInternet', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'command', 'category', 'stage', 'planSummary', 'verificationResult', 'requiresInternet', 'createdAt', 'updatedAt']) &&
                         isValidAssistantTask(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(taskId) &&
                         isValidAssistantTask(incoming()) &&
                         !(existing().stage in ['completed', 'failed']) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['stage', 'planSummary', 'verificationResult', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(taskId);
      }
    }
  }
}
